              },
              "node_name": {
                "type": "keyword"
              },
              "os@build_id": {
                "type": "keyword"
              },
              "os@description": {
                "type": "keyword"
              },
              "os@name": {
                "type": "keyword"
              },
              "os@type": {
                "type": "keyword"
              },
              "os@version": {
                "type": "keyword"
              },
              "process@command": {
                "type": "keyword"
              },
              "process@command_args": {
                "type": "keyword"
              },
              "process@command_line": {
                "type": "keyword"
              },
              "process@executable@name": {
                "type": "keyword"
              },
              "process@executable@path": {
                "type": "keyword"
              },
              "process@owner": {
                "type": "keyword"
              },
              "process@pid": {
                "type": "long"
              },
              "process@runtime@description": {
                "type": "keyword"
              },
              "process@runtime@name": {
                "type": "keyword"
              },
              "process@runtime@version": {
                "type": "keyword"
              },
              "service@instance@id": {
                "type": "keyword"
              },
              "service@name": {
                "type": "keyword"
              },
              "service@namespace": {
                "type": "keyword"
              },
              "service@version": {
                "type": "keyword"
              },
              "telemetry@auto@version": {
                "type": "keyword"
              },
              "telemetry@distro@name": {
                "type": "keyword"
              },
              "telemetry@distro@version": {
                "type": "keyword"
              },
              "telemetry@sdk@language": {
                "type": "keyword"
              },
              "telemetry@sdk@name": {
                "type": "keyword"
              },
              "telemetry@sdk@version": {
                "type": "keyword"
              },
              "zone_name": {
                "type": "keyword"
              },
              "process@command_args_mv": {
                "type": "keyword"{%- if composite %},
                "multi_value": true{%- endif %}
              }
            },
            "dynamic": true
          }
        }
      },
      "schemaUrl": {
        "type": "keyword"
      },
      "serviceName": {
        "type": "keyword"
      },
      "severityNumber": {
        "type": "integer"
      },
      "severityText": {
        "type": "keyword"
      },
      "spanId": {
        "type": "keyword"
      },
      "time": {
        "type": "date_nanos"
      },
      "traceId": {
        "type": "keyword"
      },
      "eventTime": {
        "type": "date_nanos"
      }
    }
  }
}
