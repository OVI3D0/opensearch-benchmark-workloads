{
  "name": "big5",
  "default": true,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="common/big5-schedule.json") }}
  ]
},
{
  "name": "grpc-big5",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/grpc_workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="grpc/grpc-schedule.json") }}
  ]
},
{
  "name": "test",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="common/test-schedule.json") }}
  ]
},
{
  "name": "ppl",
  "description": "Indexes the whole document corpus using OpenSearch default settings and runs PPL (Piped Processing Language) queries. Requires the SQL plugin to be installed.",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="ppl/ppl-schedule.json") }},
    {{ benchmark.collect(parts="ppl/ppl-schedule-histogram-only.json") }}
  ]
},
{
  "name": "ppl-test",
  "description": "Indexes the whole document corpus and runs a single PPL query to test SQL plugin availability.",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="ppl/ppl-test-schedule.json") }}
  ]
},
{
  "name": "ppl-calcite-disabled",
  "description": "Indexes the whole document corpus and runs PPL queries without histogram operations (for use when Calcite is disabled in version 3.2.0). Requires the SQL plugin to be installed.",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="ppl/ppl-schedule.json") }}
  ]
},
{
  "name": "intra-segment",
  "description": "Runs search queries for testing intra-segment search",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {{ benchmark.collect(parts="intra_segment/intra-segment-schedule.json") }}
  ]
},
{
  "name": "redline-ppl-random-mix",
  "description": "Sustained random-mix PPL load for redline / ramp-up testing. Each client picks one of the workload's PPL queries uniformly at random per request. Aggregate stats only (no per-query breakdown). Set search_clients high to ramp; tune target_throughput to find the engine's redline.",
  "default": false,
  "schedule": [
    {
      "operation": {
        "name": "random-ppl-query",
        "operation-type": "raw-request",
        "param-source": "random-ppl-mix",
        "index_name": "{{ index_name | default('big5') }}"
      },
      "warmup-time-period": {{ warmup_time_period | default(60) | tojson }},
      "time-period": {{ time_period | default(600) | tojson }},
      "target-throughput": {{ target_throughput | default(1000) | tojson }},
      "clients": {{ search_clients | default(100) | tojson }}
    }
  ]
}
