{% import "benchmark.helpers" as benchmark with context %}
{
  "version": 2,
  "description": "OTel logs + traces in the Data Prepper 'standard' index shape (logs-otel-v1 / otel-v1-apm-span / otel-v2-apm-service-map) for high-volume indexing-throughput and resilience testing. Templates are Data Prepper's own, plus keyword dynamic templates for events/links attributes (composite rejects text under nested). Writes go to ISM rollover aliases. Corpus is generated locally by MustangBenchmarkConfigResults scripts/otel-loadtest/otel_dp_ingest.py corpus (no base-url).",
  "indices": [
    {"name": "logs-otel-v1-000001", "body": "indices/logs-otel-v1-bootstrap.json"},
    {"name": "otel-v1-apm-span-000001", "body": "indices/otel-v1-apm-span-bootstrap.json"},
    {"name": "otel-v2-apm-service-map", "body": "indices/otel-v2-apm-service-map.json"}
  ],
  "corpora": [
    {
      "name": "otel_dp_logs",
      "documents": [
        {"source-file": "logs.json", "document-count": {{ logs_document_count | default(100000000) }}, "target-index": "logs-otel-v1"}
      ]
    },
    {
      "name": "otel_dp_spans",
      "documents": [
        {"source-file": "spans.json", "document-count": {{ spans_document_count | default(100000000) }}, "target-index": "otel-v1-apm-span"}
      ]
    },
    {
      "name": "otel_dp_service_map",
      "documents": [
        {"source-file": "service-map.json", "document-count": {{ service_map_document_count | default(46) }}, "target-index": "otel-v2-apm-service-map"}
      ]
    }
  ],
  "operations": [
    {{ benchmark.collect(parts="operations/*.json") }}
  ],
  "test_procedures": [
    {{ benchmark.collect(parts="test_procedures/*.json") }}
  ]
}
