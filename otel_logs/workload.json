{
  "version": 2,
  "description": "OTel logs benchmark: 39 queries (PPL, plus DSL and ClickHouse/DataFusion/OpenObserve SQL translations) over the frozen 30M-doc OTel corpus. otel-logs-ingest loads the corpus; the search procedures (otel-logs-ppl, dsl-otel-logs, …) run against an existing otel_logs index.",
  "indices": [
    {
      "name": "{{ index_name | default('otel_logs') }}",
      "body": "{{ index_body | default('index-datafusion.json') }}"
    }
  ],
  "corpora": [
    {
      "name": "otel_logs",
      "base-url": "https://mustang-nightly-mikeovi.s3.amazonaws.com/perf/corpora/otel/v1",
      "documents": [
        {
          "source-file": "otel_logs-v1.json.gz",
          "document-count": 30000000,
          "compressed-bytes": 5940152880,
          "uncompressed-bytes": 45240642202
        }
      ]
    }
  ],
  "operations": [
    {{ benchmark.collect(parts="operations/*.json") }}
  ],
  "test_procedures": [
    {{ benchmark.collect(parts="test_procedures/*.json") }}
  ]
}
