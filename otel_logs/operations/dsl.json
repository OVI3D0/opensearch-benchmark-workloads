{
  "name": "dsl-t1-01-spans-per-minute",
  "operation-type": "raw-request",
  "path": "/{{ spans_index | default('otel_spans') }}/_search",
  "method": "POST",
  "body": {
    "size": 0,
    "track_total_hits": false,
    "aggs": {
      "g": {
        "composite": {
          "size": 10000,
          "sources": [
            {
              "ts": {
                "date_histogram": {
                  "field": "startTime",
                  "fixed_interval": "1m",
                  "format": "yyyy-MM-dd HH:mm:ss",
                  "order": "asc"
                }
              }
            },
            {
              "serviceName": {
                "terms": {
                  "field": "serviceName",
                  "order": "asc"
                }
              }
            }
          ]
        }
      }
    }
  }
},
{
  "name": "dsl-t1-02-apdex-per-service",
  "operation-type": "raw-request",
  "path": "/{{ spans_index | default('otel_spans') }}/_search",
  "method": "POST",
  "body": {
    "size": 0,
    "track_total_hits": false,
    "aggs": {
      "g": {
        "terms": {
          "field": "serviceName",
          "size": 10000
        },
        "aggs": {
          "s": {
            "filter": {
              "range": {
                "durationInNanos": {
                  "lte": 500000000
                }
              }
            }
          },
          "t": {
            "filter": {
              "range": {
                "durationInNanos": {
                  "gt": 500000000,
                  "lte": 2000000000
                }
              }
            }
          },
          "apdex": {
            "bucket_script": {
              "buckets_path": {
                "s": "s>_count",
                "t": "t>_count",
                "n": "_count"
              },
              "script": "(params.s + params.t * 0.5) / params.n"
            }
          },
          "order": {
            "bucket_sort": {
              "sort": [
                {
                  "apdex": "asc"
                }
              ],
              "size": 10000
            }
          }
        }
      }
    },
    "query": {
      "terms": {
        "kind": [
          "SPAN_KIND_SERVER",
          "SPAN_KIND_CONSUMER"
        ]
      }
    }
  }
},
{
  "name": "dsl-t1-03-slow-ops-eventstats",
  "operation-type": "raw-request",
  "path": "/{{ spans_index | default('otel_spans') }}/_search",
  "method": "POST",
  "body": {
    "size": 0,
    "track_total_hits": false,
    "aggs": {
      "all": {
        "filter": {
          "exists": {
            "field": "name"
          }
        },
        "aggs": {
          "affected": {
            "filter": {
              "range": {
                "durationInNanos": {
                  "gt": 100000000
                }
              }
            }
          }
        }
      },
      "g": {
        "terms": {
          "field": "name",
          "size": 10000
        },
        "aggs": {
          "affected": {
            "filter": {
              "range": {
                "durationInNanos": {
                  "gt": 100000000
                }
              }
            }
          },
          "rate": {
            "bucket_script": {
              "buckets_path": {
                "a": "affected>_count",
                "n": "_count"
              },
              "script": "params.a / params.n"
            }
          },
          "having": {
            "bucket_selector": {
              "buckets_path": {
                "n": "_count"
              },
              "script": "params.n >= 20"
            }
          },
          "order": {
            "bucket_sort": {
              "sort": [
                {
                  "rate": "desc"
                }
              ],
              "size": 20
            }
          }
        }
      }
    },
    "query": {
      "bool": {
        "must": [
          {
            "term": {
              "serviceName": {
                "value": "frontend"
              }
            }
          },
          {
            "term": {
              "kind": {
                "value": "SPAN_KIND_SERVER"
              }
            }
          }
        ]
      }
    }
  }
},
