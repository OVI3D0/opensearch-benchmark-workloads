  "name": "dsl-t1-17-log-patterns",
  "operation-type": "raw-request",
  "path": "/{{ logs_index | default('otel_logs') }}/_search",
  "method": "POST",
  "body": {
    "size": 0,
    "track_total_hits": false,
    "aggs": {
      "g": {
        "terms": {
          "script": {
            "lang": "painless",
            "source": "if (doc['body.keyword'].size() == 0) { return ''; } def s = doc['body.keyword'].value; return s.isEmpty() ? '' : /[a-zA-Z0-9]+/.matcher(s).replaceAll('<*>');"
          },
          "size": 20,
          "shard_size": 2147483647,
          "order": [
            {
              "_count": "desc"
            },
            {
              "_key": "asc"
            }
          ]
        }
      }
    },
    "query": {
      "bool": {
        "must": [
          {
            "term": {
              "serviceName": {
                "value": "cart"
              }
            }
          },
          {
            "exists": {
              "field": "body"
            }
          }
        ],
        "must_not": [
          {
            "wildcard": {
              "body.keyword": {
                "value": "*ValkeyCartStore*",
                "case_insensitive": true
              }
            }
          },
          {
            "wildcard": {
              "body.keyword": {
                "value": "*called with userId*",
                "case_insensitive": true
              }
            }
          }
        ]
      }
    }
  }
},
