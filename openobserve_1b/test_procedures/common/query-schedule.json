{% for q in range(1, 20) %}
{
  "operation": "q{{ '%02d' | format(q) }}-{{ engine_suffix }}",
  "warmup-iterations": {{ warmup_iterations | default(1) | tojson }},
  "iterations": {{ test_iterations | default(5) | tojson }},
  "target-throughput": {{ target_throughput | default(0) | tojson }},
  "clients": {{ search_clients | default(1) }}
}{% if not loop.last %},{% endif %}
{% endfor %}
